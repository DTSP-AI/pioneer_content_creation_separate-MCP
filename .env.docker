# Content Creation Agent - Docker Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# Core AI Services (REQUIRED)
# ============================================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (for embeddings + supervisor routing)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# Memory Services (REQUIRED)
# ============================================================================

# Mem0 Cloud Memory
MEM0_API_KEY=your_mem0_api_key_here
MEM0_ORG_ID=default-org

# Qdrant Vector Store (internal service)
# These are set automatically by docker-compose
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
QDRANT_COLLECTION=content_creation_memory
QDRANT_API_KEY=

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================

# PostgreSQL (internal service)
POSTGRES_PASSWORD=changeme_in_production
# These are set automatically by docker-compose:
# POSTGRES_USER=agentuser
# POSTGRES_DB=content_agent
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ============================================================================
# PiAPI Integration (REQUIRED for video generation)
# ============================================================================

# PiAPI API Key
PIAPI_API_KEY=your_piapi_api_key_here

# PiAPI MCP Server (internal service)
# This is set automatically by docker-compose:
# PIAPI_MCP_SERVER_URL=http://piapi-mcp:7870/sse
PIAPI_MCP_ENABLED=true

# ============================================================================
# Google Services (OPTIONAL)
# ============================================================================

# Google Cloud (for Sheets, YouTube)
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=

# YouTube OAuth (place client_secret.json in ./secrets/)
# YOUTUBE_CLIENT_SECRET_PATH=/app/secrets/client_secret.json

# ============================================================================
# Cost Limits
# ============================================================================

MAX_DAILY_COST_USD=100.0
MAX_PER_WORKFLOW_COST_USD=10.0

# ============================================================================
# Application Settings
# ============================================================================

APP_NAME=Content Creation Agent
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# Docker Setup Instructions
# ============================================================================

# 1. Copy this file to .env:
#    cp .env.docker .env
#
# 2. Fill in your API keys above
#
# 3. (Optional) Place YouTube OAuth credentials:
#    mkdir -p secrets
#    cp /path/to/client_secret.json secrets/
#
# 4. Start all services:
#    docker-compose up -d
#
# 5. View logs:
#    docker-compose logs -f backend
#
# 6. Stop all services:
#    docker-compose down
#
# 7. Start with Streamlit UI:
#    docker-compose --profile ui up -d
#
# 8. Production deployment with Nginx:
#    docker-compose --profile production up -d

# ============================================================================
# Service URLs (when running)
# ============================================================================

# Backend API: http://localhost:8000
# Streamlit UI: http://localhost:8501 (with --profile ui)
# PostgreSQL: localhost:5432
# Qdrant: http://localhost:6333
# PiAPI MCP: http://localhost:7870
# Redis: localhost:6379 (with --profile optional)
